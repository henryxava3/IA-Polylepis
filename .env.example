# Copiar a .env. Nunca compartir este archivo con claves reales.
POSTGRES_PASSWORD=polylepis_local
DATABASE_URL=postgresql://polylepis:polylepis_local@127.0.0.1:54329/polylepis
# false para PostgreSQL nativo sin extensiones; Docker lo activa automáticamente.
DATABASE_EXTENSIONS=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENALEX_API_KEY=
CONTACT_EMAIL=
GBIF_USERNAME=
GBIF_PASSWORD=
DATA_DIR=./data
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDINGS_ENABLED=true
BACKEND_URL=http://127.0.0.1:8000
